---
import Layout from '../layouts/Layout.astro';
import library from '../data/albums.json';

const firstAlbum = library.albums[0];
const firstTrack = firstAlbum?.tracks[0];
---

<Layout title="Spotify 3D / arquivo de escuta">
	<div id="app" data-catalog={JSON.stringify(library)}>
		<div id="detail-background" aria-hidden="true">
			<canvas id="detail-background-canvas"></canvas>
		</div>
		<svg id="cassette-cable" aria-hidden="true">
			<path class="cable-shadow"></path>
			<path class="cable-main"></path>
		</svg>
		<header class="topbar">
			<a class="brand" href="/" aria-label="Spotify 3D, arquivo de escuta">
				<span class="brand-mark" aria-hidden="true"><i class="fa-solid fa-cassette-tape"></i></span>
				<span class="brand-copy">
					<strong>SPOTIFY 3D</strong>
					<small>arquivo de fitas · 001</small>
				</span>
			</a>
			<button class="back-button" id="back-button" type="button" aria-label="Voltar para a coleção">
				<span aria-hidden="true">←</span><span>coleção</span>
			</button>
			<div class="topbar-meta">
				<span class="status-dot"></span>
				<span>LOCAL MODE</span>
				<span class="topbar-divider"></span>
				<span id="clock">00:00:00</span>
			</div>
		</header>
		<nav class="side-rail" aria-label="Navegação da coleção">
			<span class="rail-marker is-active"></span>
			<span class="rail-marker"></span><span class="rail-marker"></span><span class="rail-marker"></span>
			<span class="rail-marker"></span><span class="rail-marker"></span><span class="rail-marker"></span>
			<span class="rail-divider"></span><span class="rail-symbol">?</span>
		</nav>

		<main class="workspace">
			<div class="rack-scroll" id="rack-scroll">
				<div class="stage" id="cassette-rack" aria-label="Coleção de fitas"></div>
			</div>

			<aside class="now-playing" aria-label="Reprodução atual">
				<div class="player-shell">
					<span class="player-jack" id="player-jack" aria-hidden="true"><span class="player-jack-sleeve"></span><span class="player-jack-metal"></span></span><span class="player-jack-port" aria-hidden="true"></span>
					<div class="ipod-screen">
						<div class="player-topline">
							<span>LOCAL DECK <b>01</b></span>
							<span class="player-state"><i></i><strong id="player-state">PAUSADO</strong></span>
						</div>
						<div class="solaris-player">
							<canvas id="solaris-player-canvas" aria-label="Esfera Solaris reativa à música"></canvas>
						</div>
						<div class="player-identity">
							<figure class="player-cover">
								<img id="player-cover" src={firstAlbum?.cover} alt={firstAlbum?.title ?? 'Capa do álbum'} />
							</figure>
							<div class="player-heading">
								<span class="player-kicker" id="track-kicker">{firstAlbum?.artist ?? ''}</span>
								<h2 id="album-name">{firstAlbum?.title ?? ''}</h2>
								<p><span id="album-year">{firstAlbum?.year ?? ''}</span><span>FITA ORIGINAL · SIDE A</span></p>
							</div>
						</div>
						<div class="now-playing-track">
							<div><span class="np-label">TOCANDO AGORA</span><span class="np-index">FAIXA <b id="track-number">01</b></span></div>
							<strong id="track-name">{firstTrack?.title ?? ''}</strong>
						</div>
						<div class="track-list-head"><span>FAIXAS DA FITA</span><span id="track-count">00 FAIXAS</span></div>
						<div class="track-list" id="track-list"></div>
						<div class="progress-row"><span id="current-time">0:00</span><input id="progress-control" class="progress" type="range" min="0" max="100" value="0" step="0.1" aria-label="Progresso da faixa" /><span id="total-time">{firstTrack?.duration ?? '0:00'}</span></div>
					</div>
					<div class="player-controls">
						<button class="icon-button" id="shuffle-button" type="button" aria-label="Embaralhar playlist" title="Embaralhar playlist"><i class="fa-solid fa-shuffle" aria-hidden="true"></i></button>
						<button class="icon-button" id="previous-button" type="button" aria-label="Faixa anterior" title="Faixa anterior"><i class="fa-solid fa-backward-step" aria-hidden="true"></i></button>
						<button class="play-button" id="play-button" type="button" aria-label="Reproduzir" title="Reproduzir"><i class="fa-solid fa-play" aria-hidden="true"></i></button>
						<button class="icon-button" id="next-button" type="button" aria-label="Próxima faixa" title="Próxima faixa"><i class="fa-solid fa-forward-step" aria-hidden="true"></i></button>
						<button class="icon-button" id="repeat-button" type="button" aria-label="Repetir faixa" title="Repetir faixa"><i class="fa-solid fa-repeat" aria-hidden="true"></i></button>
					</div>
				</div>
			</aside>
		</main>
	</div>
</Layout>

<script>
	import { createTapeShelf } from '../scripts/tape-shelf.js';
	import { SolarisPlayer } from '../scripts/solaris-player.js';
	import { TapeCable } from '../scripts/tape-cable.js';
	import { FlutedBackground } from '../scripts/fluted-background.js';
	import { extractCoverPalette } from '../scripts/color-palette.js';

	const root = document.querySelector('#app');
	if (!root) throw new Error('Spotify 3D app root not found');

	const catalog = JSON.parse(root.dataset.catalog || '{"albums":[]}');
	const rack = document.querySelector('#cassette-rack');
	const rackScroll = document.querySelector('#rack-scroll');
	const backButton = document.querySelector('#back-button');
	const cassetteCable = document.querySelector('#cassette-cable');
	const playerJack = document.querySelector('#player-jack');
	const detailBackgroundCanvas = document.querySelector('#detail-background-canvas');
	const detailBackground = detailBackgroundCanvas ? new FlutedBackground(detailBackgroundCanvas) : null;
	const coverPaletteCache = new Map();
	const albums = catalog.albums || [];

	const playButton = document.querySelector('#play-button');
	const playIcon = playButton?.querySelector('i');
	const shuffleButton = document.querySelector('#shuffle-button');
	const repeatButton = document.querySelector('#repeat-button');
	const playerCover = document.querySelector('#player-cover');
	const playerState = document.querySelector('#player-state');
	const albumYear = document.querySelector('#album-year');
	const trackNumber = document.querySelector('#track-number');
	const trackCount = document.querySelector('#track-count');
	const progressControl = document.querySelector('#progress-control');
	const audio = new Audio();
	audio.preload = 'auto';
	const solarisCanvas = document.querySelector('#solaris-player-canvas');
	const solarisPlayer = solarisCanvas ? new SolarisPlayer(solarisCanvas) : null;
	solarisPlayer?.attachAudio(audio);

	let albumIndex = 0;
	let trackIndex = 0;
	let isPlaying = false;
	let shuffleEnabled = false;
	let repeatEnabled = false;
	let collectionScrollY = 0;
	let tapeCable = null;

	const currentAlbum = () => albums[albumIndex];
	const currentTrack = () => currentAlbum()?.tracks?.[trackIndex];

	function formatTime(seconds) {
		if (!Number.isFinite(seconds)) return '0:00';
		return `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;
	}

	function updatePlayer() {
		const album = currentAlbum();
		const track = currentTrack();
		if (!album || !track) return;
		const kicker = document.querySelector('#track-kicker');
		const name = document.querySelector('#track-name');
		const albumName = document.querySelector('#album-name');
		const total = document.querySelector('#total-time');
		const trackList = document.querySelector('#track-list');
		if (playerCover) {
			playerCover.src = album.cover;
			playerCover.alt = `Capa de ${album.title}`;
		}
		if (playerState) playerState.textContent = isPlaying ? 'TOCANDO' : 'PAUSADO';
		if (albumYear) albumYear.textContent = album.year || '';
		if (trackNumber) trackNumber.textContent = String(trackIndex + 1).padStart(2, '0');
		if (trackCount) trackCount.textContent = `${String(album.tracks.length).padStart(2, '0')} FAIXAS`;
		if (kicker) kicker.textContent = album.artist;
		if (name) name.textContent = track.title;
		if (albumName) albumName.textContent = album.title;
		if (total) total.textContent = track.duration || '0:00';
		if (progressControl && !audio.duration) progressControl.value = '0';
		if (playIcon) {
			playIcon.classList.toggle('fa-play', !isPlaying);
			playIcon.classList.toggle('fa-pause', isPlaying);
		}
		if (playButton) {
			playButton.setAttribute('aria-label', isPlaying ? 'Pausar' : 'Reproduzir');
			playButton.title = isPlaying ? 'Pausar' : 'Reproduzir';
		}
		shuffleButton?.classList.toggle('is-active', shuffleEnabled);
		repeatButton?.classList.toggle('is-active', repeatEnabled);
		shelf?.setPlayback(albumIndex, isPlaying);
		if (trackList) trackList.innerHTML = album.tracks.map((item, index) => `<button type="button" class="track-row ${index === trackIndex ? 'is-active' : ''}" data-track-index="${index}"><span>${String(index + 1).padStart(2, '0')}</span><strong>${item.title}</strong><small>${item.duration || '—'}</small></button>`).join('');
		trackList?.querySelectorAll('[data-track-index]').forEach((row) => row.addEventListener('click', () => {
			trackIndex = Number(row.dataset.trackIndex);
			loadTrack(true);
		}));
	}

	function loadTrack(shouldPlay = false) {
		const track = currentTrack();
		if (!track) return;
		audio.src = track.src;
		audio.load();
		if (shouldPlay) {
			Promise.resolve(solarisPlayer?.prepareAudio())
				.then(() => audio.play())
				.then(() => {
					isPlaying = true;
					updatePlayer();
				})
				.catch((err) => {
					console.warn('Playback error:', err);
					isPlaying = false;
					updatePlayer();
				});
		} else {
			isPlaying = false;
			updatePlayer();
		}
	}

	async function syncCoverPalette(album) {
		if (!album?.cover) return;
		let palette = coverPaletteCache.get(album.cover);
		if (!palette) {
			palette = await extractCoverPalette(album.cover, {
				top: album.accent || album.color || '#ff6b3d',
				bottom: album.color || '#3366ff',
				accent: album.accent || '#f4b45d',
			});
			coverPaletteCache.set(album.cover, palette);
		}
		if (currentAlbum() !== album) return;
		detailBackground?.setPalette(palette);
		solarisPlayer?.setPalette(palette);
		root.style.setProperty('--tint', palette.accent);
	}

	function openAlbum(index, { pushUrl = true, autoplay = true } = {}) {
		if (!root.classList.contains('mode-detail')) {
			collectionScrollY = window.scrollY;
		}
		albumIndex = index;
		trackIndex = 0;
		isPlaying = false;
		audio.pause();
		solarisPlayer?.setPlaying(false);
		audio.currentTime = 0;
		root.classList.add('mode-detail');
		detailBackground?.setActive(true);
		solarisPlayer?.setActive(true);
		tapeCable?.setActive(true);
		root.style.setProperty('--tint', currentAlbum()?.color || '#886644');
		syncCoverPalette(currentAlbum());
		shelf?.enter(index);
		loadTrack(autoplay);
		if (pushUrl) {
			const id = currentAlbum()?.id;
			if (id) history.pushState({ album: id }, '', `?fita=${id}`);
		}
	}

	function closeAlbum({ pushUrl = true } = {}) {
		detailBackground?.setActive(false);
		solarisPlayer?.setActive(false);
		tapeCable?.setActive(false);
		root.classList.remove('mode-detail');
		shelf?.exit();
		// O modo detalhe é mais curto que a coleção. Restaure a posição capturada
		// depois que a altura da estante voltar, senão o navegador prende o scrollY
		// em zero enquanto a visão de detalhe está aberta.
		requestAnimationFrame(() => {
			window.scrollTo({ top: collectionScrollY, left: 0, behavior: 'auto' });
			requestAnimationFrame(updateScroll);
		});
		if (pushUrl) history.pushState({}, '', location.pathname);
	}

	const shelf = rack && albums.length
		? createTapeShelf({ container: rack, albums, onSelect: openAlbum })
		: null;

	if (shelf && cassetteCable && playerJack) {
		tapeCable = new TapeCable({
			svg: cassetteCable,
			getTapeAnchor: () => shelf.getFocusedCableAnchor(),
			getPlayerAnchor: () => {
				const rect = playerJack.getBoundingClientRect();
				// The flexible cable meets the top of the rigid plug sleeve, not the
				// iPod body underneath it.
				return { x: rect.left + rect.width / 2, y: rect.top + 2 };
			},
		});
	}

	// Libera a cena WebGL quando o documento está mesmo indo embora. Manter a cena
	// viva para restaurações de bfcache preserva a última posição da estante quando
	// o usuário volta com o botão do navegador.
	window.addEventListener('pagehide', (event) => {
		if (!event.persisted) {
			shelf?.destroy();
			detailBackground?.destroy();
			solarisPlayer?.destroy();
			tapeCable?.destroy();
		}
	}, { once: true });

	function viewportHeight() {
		return document.documentElement.clientHeight || window.innerHeight;
	}

	function updateScroll() {
		if (!shelf || !rackScroll || root.classList.contains('mode-detail')) return;
		const total = Math.max(rackScroll.offsetHeight - viewportHeight(), 0);
		const progress = total > 0 ? window.scrollY / total : 0;
		shelf.setScroll(progress);
	}

	function syncRackScrollMetrics() {
		if (!rackScroll) return;
		// O percurso em CSS é proporcional à viewport, enquanto o percurso 3D é
		// proporcional à distância entre as fitas. Recalcule quando a viewport
		// mudar, em vez de manter um passo de 260px pensado só para desktop.
		const step = Math.round(Math.max(220, Math.min(300, viewportHeight() * 0.28)));
		const extra = Math.max(albums.length - 1, 0) * step;
		rackScroll.style.setProperty('--rack-extra', `${extra}px`);
		requestAnimationFrame(updateScroll);
	}

	// Trackpads e mouses horizontais devem continuar navegando a estante vertical.
	// Isso mantém a interação natural sem exigir um segundo layout horizontal, que
	// tornaria a pilha de fitas mais difícil de ler.
	function handleHorizontalWheel(event) {
		if (root.classList.contains('mode-detail')) return;
		const horizontalIntent = Math.abs(event.deltaX) > Math.abs(event.deltaY) || event.shiftKey;
		if (!horizontalIntent || !event.deltaX && !event.deltaY) return;
		event.preventDefault();
		window.scrollBy({ top: event.deltaX || event.deltaY, behavior: 'auto' });
	}

	window.addEventListener('scroll', updateScroll, { passive: true });
	window.addEventListener('wheel', handleHorizontalWheel, { passive: false });
	window.addEventListener('resize', syncRackScrollMetrics, { passive: true });
	if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
	syncRackScrollMetrics();
	if (!new URLSearchParams(location.search).has('fita')) {
		window.scrollTo(0, 0);
	}
	updateScroll();

	backButton?.addEventListener('click', () => closeAlbum());

	window.addEventListener('popstate', () => {
		const requested = new URLSearchParams(location.search).get('fita');
		const index = requested ? albums.findIndex((album) => album.id === requested) : -1;
		if (index >= 0) openAlbum(index, { pushUrl: false, autoplay: false });
		else closeAlbum({ pushUrl: false });
	});

	const initialId = new URLSearchParams(location.search).get('fita');
	const initialIndex = initialId ? albums.findIndex((album) => album.id === initialId) : -1;
	if (initialIndex >= 0) openAlbum(initialIndex, { pushUrl: false, autoplay: false });

	function updateClock() {
		const clock = document.querySelector('#clock');
		if (clock) clock.textContent = new Date().toLocaleTimeString('pt-BR', { hour12: false });
	}

	setInterval(updateClock, 1000);
	updateClock();

	playButton?.addEventListener('click', () => {
		if (!audio.src || audio.src === '' || audio.src === window.location.href) {
			loadTrack(true);
			return;
		}
		if (isPlaying) {
			audio.pause();
		} else {
			Promise.resolve(solarisPlayer?.prepareAudio())
				.then(() => audio.play())
				.then(() => {
					isPlaying = true;
					updatePlayer();
				})
				.catch((err) => {
					console.warn('Playback error:', err);
					isPlaying = false;
					updatePlayer();
				});
		}
	});

	audio.addEventListener('play', () => {
		isPlaying = true;
		solarisPlayer?.setPlaying(true);
		updatePlayer();
	});

	audio.addEventListener('pause', () => {
		isPlaying = false;
		solarisPlayer?.setPlaying(false);
		updatePlayer();
	});

	function getNextTrackIndex() {
		const length = currentAlbum()?.tracks?.length || 1;
		if (!shuffleEnabled || length < 2) return (trackIndex + 1) % length;
		let next = trackIndex;
		while (next === trackIndex) next = Math.floor(Math.random() * length);
		return next;
	}

	document.querySelector('#next-button')?.addEventListener('click', () => {
		trackIndex = getNextTrackIndex();
		loadTrack(isPlaying);
	});

	document.querySelector('#previous-button')?.addEventListener('click', () => {
		trackIndex = (trackIndex - 1 + (currentAlbum()?.tracks?.length || 1)) % (currentAlbum()?.tracks?.length || 1);
		loadTrack(isPlaying);
	});

	shuffleButton?.addEventListener('click', () => {
		shuffleEnabled = !shuffleEnabled;
		updatePlayer();
	});

	repeatButton?.addEventListener('click', () => {
		repeatEnabled = !repeatEnabled;
		audio.loop = repeatEnabled;
		updatePlayer();
	});

	audio.addEventListener('timeupdate', () => {
		const current = document.querySelector('#current-time');
		if (progressControl) progressControl.value = audio.duration ? String((audio.currentTime / audio.duration) * 100) : '0';
		if (current) current.textContent = formatTime(audio.currentTime);
	});

	progressControl?.addEventListener('input', () => {
		if (Number.isFinite(audio.duration) && audio.duration > 0) {
			audio.currentTime = (Number(progressControl.value) / 100) * audio.duration;
		}
	});

	audio.addEventListener('ended', () => {
		trackIndex = getNextTrackIndex();
		loadTrack(true);
	});

	updatePlayer();
</script>

<style is:global>
	html { background: #201819; }
	body { min-width: 0; margin: 0; background: #201819; color: #f1eadf; font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace; }
	* { box-sizing: border-box; }
	button { font: inherit; }

	#app { --tint: #886644; position: relative; min-height: 100svh; overflow-x: clip; background: #201819; transition: background 1.1s ease; }
	#app.mode-detail { background: transparent; }
	#detail-background { position: fixed; z-index: 0; inset: 0; overflow: hidden; opacity: 0; pointer-events: none; transition: opacity .8s ease; }
	#detail-background canvas { display: block; width: 100%; height: 100%; filter: brightness(.86) saturate(.96) contrast(1.02); }
	#app.mode-detail #detail-background { opacity: 1; }
	#app.mode-detail::after { position: fixed; z-index: 1; inset: 0; background: radial-gradient(ellipse 58% 70% at 50% 53%, transparent 38%, rgba(5,6,8,.035) 66%, rgba(4,5,7,.16) 100%); content: ''; pointer-events: none; }

	.workspace, .topbar { position: relative; z-index: 2; }

	.topbar { display: flex; align-items: center; justify-content: space-between; height: 88px; padding: 0 clamp(24px, 4.7vw, 78px); border-bottom: 1px solid rgba(255, 236, 204, .13); }
	#app:not(.mode-detail) .topbar { border-bottom-color: transparent; background: linear-gradient(180deg, rgba(20, 15, 14, .38), transparent); position: absolute; top: 0; right: 0; left: 0; z-index: 5; }
	#app:not(.mode-detail) .brand, #app:not(.mode-detail) .topbar-meta { opacity: 1; pointer-events: auto; }
	#app:not(.mode-detail) .bottom-note { display: none; }
	#app.mode-detail .topbar { border-bottom-color: rgba(255,255,255,.17); background: linear-gradient(180deg, rgba(5,6,8,.76), rgba(5,6,8,.25)); box-shadow: 0 8px 28px rgba(0,0,0,.25); backdrop-filter: blur(12px); }

	.brand { display: flex; align-items: center; gap: 12px; color: #f2eadc; text-decoration: none; }
	.brand-mark { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid rgba(235, 198, 145, .65); border-radius: 50%; color: #221916; background: #dca262; box-shadow: 0 0 0 4px rgba(220, 162, 98, .1), inset 0 0 0 2px rgba(255, 241, 212, .2); font-size: 18px; transform: rotate(-5deg); transition: transform .25s ease, box-shadow .25s ease; }
	.brand:hover .brand-mark { box-shadow: 0 0 0 7px rgba(220, 162, 98, .13), inset 0 0 0 2px rgba(255, 241, 212, .25); transform: rotate(4deg) scale(1.04); }
	.brand-copy strong, .brand-copy small { display: block; }
	.brand-copy strong { color: #f3e7d1; font: 700 23px/.78 "Fraunces", Georgia, serif; letter-spacing: .035em; }
	.brand-copy small { margin-top: 8px; color: #d8ccba; font: 8px/1 "JetBrains Mono", monospace; letter-spacing: .18em; text-transform: uppercase; }
	.topbar-meta { display: flex; align-items: center; gap: 10px; color: #dbd5cc; font: 9px "JetBrains Mono", monospace; letter-spacing: .17em; text-shadow: 0 1px 3px #000; }
	.status-dot, .live-dot { width: 6px; height: 6px; border-radius: 50%; background: #c7ec7b; box-shadow: 0 0 12px #a8c66c; }
	.topbar-divider { width: 1px; height: 17px; margin: 0 8px; background: rgba(255,255,255,.35); }

	.back-button { display: none; align-items: center; gap: 9px; padding: 9px 16px 9px 12px; border: 1px solid rgba(245,232,210,.58); border-radius: 999px; color: #fff6e7; background: rgba(5,6,8,.52); box-shadow: 0 4px 12px rgba(0,0,0,.28); font: 10px monospace; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; transition: border-color .2s, color .2s; }
	.back-button span:first-child { font-size: 13px; }
	.back-button:hover { border-color: #e0a05b; color: #e5a05b; }
	#app.mode-detail .back-button { display: inline-flex; }

	.side-rail { position: fixed; z-index: 6; top: 50%; left: 34px; display: flex; flex-direction: column; gap: 10px; align-items: center; transform: translateY(-50%); }
	.rail-marker { display: block; width: 16px; height: 2px; background: #6d6660; opacity: .7; }
	.rail-marker.is-active { width: 17px; background: #f1eadf; opacity: 1; }
	.rail-divider { width: 1px; height: 17px; margin-top: 4px; background: #4e4945; }
	.rail-symbol { margin-top: 245px; color: #d4cbc0; font: 20px Georgia, serif; }
	.mode-detail .side-rail { opacity: 0; pointer-events: none; }

	.workspace { max-width: 1510px; margin: 0 auto; }
	#app:not(.mode-detail) .workspace { max-width: none; padding: 0; }
	#app:not(.mode-detail) .now-playing { display: none; }
	#app.mode-detail .workspace { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(30px, 4.4vw, 72px); align-items: center; min-height: calc(100svh - 162px); padding: clamp(30px, 6vh, 64px) clamp(24px, 4.7vw, 78px); }

	.rack-scroll { position: relative; }
	#app:not(.mode-detail) .rack-scroll { height: calc(100svh + var(--rack-extra, 0px)); }
	#app.mode-detail .rack-scroll { height: auto; }

	.stage { position: relative; width: 100%; }
	#app:not(.mode-detail) .stage { position: sticky; top: 0; height: 100svh; }
